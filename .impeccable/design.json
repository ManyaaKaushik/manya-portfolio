  "narrative": {
    "northStar": "A Polymath's Garden",
    "overview": "Curiosity connects systems and empathy. The visual world feels like an open botanical notebook: warm paper, olive ink, generous serif lettering, real portraiture, and layered plant illustrations. It is personal and exploratory while keeping real design work legible to hiring teams and collaborators.\n\nThe Figma brief establishes this world rather than a screen to trace. Botanical collage frames the opening; restrained controls leave room for a native scrolling story. The implemented sequence moves from introduction and journey to real projects, collaborator voices, play, reflection, and contact. Artwork provenance belongs in ASSETS.md; factual claims remain grounded in PRODUCT.md and source material.",
    "keyCharacteristics": [
      "Cream paper and muted botanical greens.",
      "Instrument Serif display lettering paired with Instrument Sans utility text.",
      "Real portrait and botanical collage with playful pixel experimentation.",
      "Spacious editorial sections and distinct pastel project surfaces.",
      "Native scrolling, restrained parallax, and an explicit motion opt-out."
    ],
    "rules": [
      {
        "name": "The Paper and Plant Rule",
        "body": "Keep botanical color in the framing and emphasis; preserve quiet reading surfaces around body copy and case-study artwork.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use serif for expressive narrative and sans-serif for reading, controls, attribution, and metadata.",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Let collage, overlap, and tonal fields establish hierarchy before adding shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve cream, olive, botanical imagery, and the expressive serif/sans pairing.",
      "**Do** use real portraiture, real case-study artwork, and provenance recorded in ASSETS.md.",
      "**Do** keep work and contact accessible through fixed navigation and native anchors.",
      "**Do** retain readable normal-flow content when motion is paused or reduced.",
      "**Do** preserve factual biography, project claims, testimonials, and real destinations."
    ],
    "donts": [
      "**Don't** present inspiration posters or the original pixel demo as commissioned client work.",
      "**Don't** replace native scrolling with intercepted wheel or touch navigation.",
      "**Don't** hide reading content behind entrance effects.",
      "**Don't** carry the desktop sticky project stack into the mobile layout."
    ]
  }
}
