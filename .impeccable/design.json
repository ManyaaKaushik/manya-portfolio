  "narrative": {
    "northStar": "A Polymath's Garden",
    "overview": "A Polymath’s Garden is a personal editorial world on warm paper: blue ink, ASCII and dithered botanical imagery, generous serif headlines, and small, precise sans-serif annotations. Botanical curiosity remains the identity; the current world expresses it through illustrated artifacts and paper rather than literal landscape scenery.\n\nThe interface pairs a friendly welcome with professional clarity. Spacious sections hold readable copy, tactile diary pages, quiet work labels, pastel collaborator notes, and a participatory flower garden. Motion creates continuity, while direct Work access and complete static reading paths keep the portfolio useful to hiring teams.",
    "keyCharacteristics": [
      "Warm paper and blue editorial emphasis.",
      "Instrument Serif headlines with Instrument Sans reading and labels.",
      "Sampled ASCII botanicals, supplied photographs, notebook sketches and dithered cloud artwork.",
      "Paper depth concentrated in the diary, writing card and collaborator notes.",
      "Direct navigation, keyboard interaction and lighter mobile and motion-off paths."
    ],
    "rules": [
      {
        "name": "The Blue Thread Rule",
        "body": "Use blue for identity, emphasis, navigation and focus; preserve project-specific colors inside their case previews.",
        "section": "colors"
      },
      {
        "name": "The Paper Artifact Rule",
        "body": "Concentrate shadows, small rotations and folds on meaningful paper artifacts; keep work labels and section backgrounds quiet.",
        "section": "elevation"
      },
      {
        "name": "The Complete Reading Rule",
        "body": "Both introductions and all diary content remain available when motion is paused, reduced or simplified for mobile.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the current stylesheet cascade as authority: world, collections, editorial, then responsive.",
      "Do keep blue emphasis, warm paper, local typefaces and generous editorial whitespace.",
      "Do preserve real family photographs, supplied sketches and original project identity colors.",
      "Do keep direct Work navigation, visible focus and keyboard equivalents for planting and diary controls.",
      "Do show forthcoming films as honest placeholders and link writing to the supplied Medium profile.",
      "Do commit pending diary turns when motion pauses or the viewport changes."
