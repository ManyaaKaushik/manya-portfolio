      "css": ".ds-work{text-align:left;width:265px;background:transparent;border:0;border-top:1px solid var(--line,#d3d7dd);padding:18px 0 0;color:var(--ink,#242f3e);cursor:pointer;transition:transform .7s cubic-bezier(.16,1,.3,1)}.ds-work:hover{transform:translateY(-8px)}.ds-work-name{display:block;font:31px/1.1 Instrument Serif,Georgia,serif;letter-spacing:-.02em}.ds-work-type{display:block;font:11px Instrument Sans,Arial,sans-serif;color:#596372;margin-top:6px}.ds-work-meta{display:block;font:10px Instrument Sans,Arial,sans-serif;color:#596372;margin-top:15px}.ds-button:focus-visible,.ds-link:focus-visible,.ds-nav a:focus-visible,.ds-filter:focus-visible,.ds-work:focus-visible,.ds-cover:focus-visible{outline:2px solid var(--blue,#365fba);outline-offset:6px}"
